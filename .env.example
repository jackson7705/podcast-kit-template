# ---- Audio generation ------------------------------------------------------
# NotebookLM uses `notebooklm login` locally (no env var needed). Scheduled hosts use
# NOTEBOOKLM_MASTER_TOKEN_JSON (see the automation section below). Never commit or print it.
# These ElevenLabs variables remain only for explicitly selected legacy literal-TTS configs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Local TTS (tts.provider = "local"). Piper if available, else macOS `say`.
# PIPER_MODEL=/path/to/voice.onnx
# SAY_VOICE=Samantha

# ---- Hosting ---------------------------------------------------------------
# Cloudflare R2 (default). Needs a CUSTOM DOMAIN on the bucket — the r2.dev
# development URL is rate-limited and not for production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=https://podcast.example.com

# Bunny.net — for keeping your DNS where it is (one CNAME, no nameserver move).
# BUNNY_STORAGE_ZONE=
# BUNNY_ACCESS_KEY=
# BUNNY_REGION=
# BUNNY_PUBLIC_BASE=

# S3 (+ a CDN in front, or egress will cost you).
# S3_BUCKET=
# S3_REGION=
# S3_PUBLIC_BASE=

# local backend: stage to output/_upload/ and copy it anywhere yourself.
# PUBLIC_BASE=https://podcast.example.com

# ---- Scheduled automation (optional; set these as secrets on your host) ----
# BLOG_FEED_URL=https://yoursite.com/feed
# BLOG_POSTS_API_URL=            # defaults to <blog origin>/wp-json/wp/v2/posts
# PODCAST_FEED_URL=              # defaults to feedUrl in show.config.json
# AUTOMATION_TIME_ZONE=America/Chicago
# PUBLISH_INTERVAL_DAYS=2
# BACKLOG_ALERT_THRESHOLD=10
# NOTEBOOKLM_MASTER_TOKEN_JSON=  # contents of master_token.json, from `notebooklm login --master-token`
# Email alerts through the Composio CLI's Gmail connection:
# AUTOMATION_EMAIL_ALERTS=1
# ALERT_TO_EMAIL=you@example.com
# ALERT_FROM_EMAIL=you@example.com
# ALERT_DASHBOARD_URL=           # optional link to your host's logs
# COMPOSIO_USER_DATA_JSON=
